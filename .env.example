# .env.example — vai pro repo SEM valores reais. Copie pra .env e preencha.
# Gere segredos com: openssl rand -hex 32

# URL pública do site (em dev: http://localhost:3130)
NEXT_PUBLIC_SERVER_URL=http://localhost:3130

# Segredo do Payload (obrigatório)
PAYLOAD_SECRET=

# Banco usado pelo `pnpm dev` e pelos testes no host (o container do app
# usa mongodb://mongo:27017/pronto_falei?replicaSet=rs0, definido no compose).
DATABASE_URI=mongodb://127.0.0.1:27017/pronto_falei?replicaSet=rs0&directConnection=true

# MinIO (Silo): usuário root (só o minio-init usa)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Storage das imagens (usuário restrito do app, criado pelo minio-init).
# S3_ENDPOINT vale pro `pnpm dev`/testes no host; o container do app usa
# http://minio:9000 (definido no compose).
S3_ENDPOINT=http://127.0.0.1:3131
S3_BUCKET=pronto-falei-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Base pública das imagens. Em dev: o MinIO direto (path-style, com o bucket).
# Em produção: https://img.<dominio-do-blog> (passo 14).
MEDIA_PUBLIC_URL=http://localhost:3131/pronto-falei-media

# Portas no host (opcional)
# APP_PORT=3130
# MONGO_PORT=27017
# MINIO_API_PORT=3131
# MINIO_CONSOLE_PORT=3132

# IA local da síntese (passo 8). Perfil do compose: ia (modelo real) ou mock.
# COMPOSE_PROFILES=ia
# Padrão: Qwen3-4B-Instruct-2507 Q3_K_M (2,1 GB, só texto). Plano B se a RAM
# apertar, sem mudar código (Gemma 3 1B Q4_K_M, 0,8 GB, só texto):
# LLM_MODEL_FILE=gemma-3-1b-it-Q4_K_M.gguf
# LLM_MODEL_URL=https://huggingface.co/unsloth/gemma-3-1b-it-GGUF/resolve/main/gemma-3-1b-it-Q4_K_M.gguf
# LLM_MODEL_SHA256=8270790f3ab69fdfe860b7b64008d9a19986d8df7e407bb018184caa08798ebd
# LLM_TIMEOUT_MS=360000
# LLM_MAX_INPUT_TOKENS=3800
# Pro `pnpm dev`/testes no host (o container do app usa http://llm:8080/v1):
# LLM_BASE_URL=http://127.0.0.1:8080/v1

# Smoke test (Playwright): só pra banco descartável de dev/CI
# E2E_EMAIL=
# E2E_PASSWORD=

TZ=America/Sao_Paulo
